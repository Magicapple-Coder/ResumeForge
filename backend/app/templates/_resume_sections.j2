{# 简历正文的共享片段：六个模板只在样式上不同，结构完全一致。
   每处文本都带 data-resume-path，供前端「点击纸面字段定位编辑」使用。

   分区顺序由 `resume_section_order` 决定（见 services/resume/resume_sections.py）：
   它永远是七个键的一个完整排列，渲染器不必处理"某个键不在列表里"的情况。
   页眉（姓名 / 求职意向 / 联系方式 / 照片）不参与排序，固定在最前。

   默认顺序与重排前的写死顺序完全一致，所以没有动过顺序的简历，输出与以前一字不差。 #}
{% import "_resume_blocks.j2" as blocks %}
<div class="header">
  <div class="header-main">
    <div class="name"><span data-resume-path="name">{{ resume.name }}</span>{% if resume.gender %} <span data-resume-path="gender" class="name-extra">{{ resume.gender }}</span>{% endif %}</div>
    {% if resume.job_intent %}<div class="intent">求职意向：<span data-resume-path="job_intent">{{ resume.job_intent }}</span></div>{% endif %}
    <div class="contact">
      {%- if resume.phone -%}<span data-resume-path="phone">{{ resume.phone }}</span>{%- endif -%}
      {%- if resume.email -%}<span data-resume-path="email">{{ resume.email }}</span>{%- endif -%}
      {%- if resume.city -%}<span data-resume-path="city">{{ resume.city }}</span>{%- endif -%}
      {%- if resume.birth_year -%}<span data-resume-path="birth_year">{{ resume.birth_year }}</span>{%- endif -%}
    </div>
  </div>
  {% if resume.photo %}<img class="profile-photo" src="{{ resume.photo }}" alt="个人照片" />{% endif %}
</div>

{% for section_key in resume_section_order -%}
{%- if section_key == "summary" %}{{ blocks.summary_block(resume) }}
{%- elif section_key == "education" %}{{ blocks.education_block(resume) }}
{%- elif section_key == "experience" %}{{ blocks.experience_block(resume) }}
{%- elif section_key == "campus_experience" %}{{ blocks.campus_block(resume) }}
{%- elif section_key == "projects" %}{{ blocks.projects_block(resume) }}
{%- elif section_key == "skills" %}{{ blocks.skills_block(resume) }}
{%- elif section_key == "awards" %}{{ blocks.awards_block(resume) }}
{%- endif %}
{% endfor -%}

<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8" />
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; img-src data: blob:; style-src 'unsafe-inline'; script-src 'nonce-{{ csp_nonce }}'; base-uri 'none'; form-action 'none'" />
<title>{{ resume.name }} - {{ resume.job_intent }} - 简历</title>
<style>
  /* 经典模板：深蓝强调色 + 左侧色条标题，最稳妥的通用样式。 */
  :root {
    --text: #1f2937;
    --muted: #6b7280;
    --line: #d9dee7;
    --accent: #16365c;
    --bg: #ffffff;
    --fs: calc({{ base_px }}px * var(--fit-scale, 1));
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body {
    font-family: "Microsoft YaHei", "PingFang SC", "Noto Sans CJK SC", sans-serif;
    color: var(--text);
    background: var(--bg);
    font-size: var(--fs);
    line-height: 1.7;
    width: 210mm;
    height: {{ page_limit * 297 }}mm;
    padding: 14mm;
  }
  .header { display: flex; align-items: flex-start; gap: calc(var(--fs) * 1.7); border-bottom: 2px solid var(--accent); padding-bottom: calc(var(--fs) * 1.1); margin-bottom: calc(var(--fs) * 1.4); }
  .header-main { flex: 1; min-width: 0; }
  .header .name { font-size: calc(var(--fs) * 1.86); font-weight: 700; color: var(--accent); letter-spacing: 1px; }
  .name-extra { font-size: var(--fs); font-weight: 400; color: var(--muted); }
  .header .intent { font-size: calc(var(--fs) * 1.07); color: var(--muted); margin-top: calc(var(--fs) * 0.28); }
  .header .contact { font-size: calc(var(--fs) * 0.93); color: var(--muted); margin-top: calc(var(--fs) * 0.57); }
  .header .contact span { margin-right: calc(var(--fs) * 1.14); }
  .profile-photo { width: calc(var(--fs) * 6.3); height: calc(var(--fs) * 8); flex: 0 0 auto; object-fit: cover; border: 1px solid var(--line); border-radius: 4px; }
  .section { margin-bottom: calc(var(--fs) * 1.3); }
  .section-title { font-size: calc(var(--fs) * 1.14); font-weight: 700; color: var(--accent); border-left: 4px solid var(--accent); padding-left: calc(var(--fs) * 0.71); margin-bottom: calc(var(--fs) * 0.71); }
  .entry { margin-bottom: calc(var(--fs) * 0.86); }
  .entry-head { display: flex; justify-content: space-between; align-items: baseline; gap: var(--fs); }
  .entry-head .title { font-size: calc(var(--fs) * 1.07); font-weight: 600; }
  .entry-head .meta { font-size: calc(var(--fs) * 0.93); color: var(--muted); white-space: nowrap; }
  .entry .sub { font-size: calc(var(--fs) * 0.93); color: var(--muted); margin: calc(var(--fs) * 0.14) 0 calc(var(--fs) * 0.28); }
  ul { padding-left: calc(var(--fs) * 1.43); }
  li { margin-bottom: calc(var(--fs) * 0.21); }
  .summary-text { font-size: var(--fs); }
  .skill-list { padding-left: 0; }
  .skill-list li { list-style: none; display: inline-block; background: #eef2f7; border-radius: 4px; padding: 0 calc(var(--fs) * 0.71); margin: 0 calc(var(--fs) * 0.57) calc(var(--fs) * 0.57) 0; font-size: calc(var(--fs) * 0.93); }
  @page { size: A4; margin: 0; }
  @media print {
    .section, .entry { break-inside: avoid; }
    /* 让背景色与边框在打印时保留：技能标签的底色/左侧色条就靠这句。
       浏览器默认**不打印背景图形**，这正是"预览里有小框、打印出来没有"的原因；
       `print-color-adjust: exact` 会强制按屏幕样式绘制，不依赖用户在打印对话框里勾选。 */
    * { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  }
</style>
</head>
<body>
{% include "_resume_sections.j2" %}
{% include "_resume_fit_script.j2" %}
</body>
</html>

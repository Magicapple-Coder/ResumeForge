# ===== ResumeForge 后端配置示例 =====
# 复制本文件为 .env 后按需修改；全部配置都有默认值，不配置也能直接运行。

# SQLite 数据库文件路径（默认在 backend/data/ 目录下自动创建）
DATABASE_URL=sqlite:///./data/resume_forge.db

# 允许跨域的前端地址，多个用英文逗号分隔（开发环境默认 Vite 端口 5173）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 单个 HTTP 请求体上限（MB）；需容纳最多 2 MB 的简历照片及资料正文
MAX_REQUEST_BODY_MB=8

# 数据恢复上传备份包的上限（MB）。该请求体是流式落盘的，内存占用与包大小无关；
# 其余接口仍受上面的 MAX_REQUEST_BODY_MB 约束。
MAX_BACKUP_UPLOAD_MB=512

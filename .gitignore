# ===== Python =====
__pycache__/
*.py[cod]
.venv/
venv/
.tmp_*_venv/
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.egg-info/

# ===== Node =====
node_modules/
dist/
coverage/
*.tsbuildinfo
node_modules/.tmp/
# vite build 的临时输出目录。docs/AGENTS 里的构建绕行方案**要求输出到仓库外面**
# （`--outDir D:\rf_build_tmp`），但真有人写进仓库时（一度出现过
# `frontend/rf_build_tmp/`），构建产物不该被误提交——加一条兜住。
# 构建产物本身可随时用 `npm run build` 重建，留着只会污染 `git status`。
rf_build_*/
frontend/rf_build_*/

# ===== 环境与本地数据 =====
.env
.env.*
!.env.example
# 在线体验构建的模板：只含 `VITE_DEMO_MODE=1`，没有本机信息，需要进仓库
# （`scripts/Build-Demo.ps1` 靠 `--mode demo` 读它）。
!.env.demo
backend/data/
# 投递专用浏览器的 user-data-dir：含登录态（Cookie / 本地存储），体积可能很大。
# 绝不进 Git（也不进数据库备份包——登录态由 Chromium 自己持久化，应用不读取）。
backend/data/browser-profile/
backend/*.db
backend/*.db-*
backend/*.sqlite
backend/*.sqlite-*
backend/*.sqlite3
backend/*.sqlite3-*
backend/backups/
backend/test_resume_forge.db
runtime/

# ===== 编辑器 =====
.vscode/
.idea/
.DS_Store
# 本地 AI 代理工具目录（技能与运行脚本），不属于项目代码
.claude/
.workbuddy/

# ===== 过程产出 =====
# 需求/设计/评审等协作过程文档，不属于产品代码；如需纳入版本管理可自行移除本行。
deliverables/

# ===== 日志 =====
*.log
